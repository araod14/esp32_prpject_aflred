# Puerto local donde escucha Node (nginx hará proxy hacia aquí)
PORT=8080

# Token que el ESP32 envía en el header X-Device-Token.
# Genera uno fuerte, p.ej.:  openssl rand -hex 32
DEVICE_TOKEN=CAMBIA_ESTE_TOKEN

# Credenciales del dashboard (HTTP Basic Auth)
DASH_USER=admin
DASH_PASS=CAMBIA_ESTA_CLAVE

# Segundos*1000 sin telemetría tras los que el ESP32 se marca OFFLINE
OFFLINE_AFTER_MS=30000

# Días de retención del histórico (0 = sin límite)
RETENTION_DAYS=7

# Ruta del archivo SQLite (opcional)
# DB_PATH=/var/lib/esp32-monitor/data.db
